# Clé API Agnes (https://platform.agnes-ai.com → Settings → API Keys)
AGNES_API_KEY=sk-remplacer-par-votre-cle

# Personal Access Token GitHub avec le droit de pousser sur le dépôt (ne jamais commiter)
GITHUB_TOKEN=ghp_remplacer-par-votre-token

# Seule cette URL https, sans identifiant embarqué, est acceptée
GIT_REPO_URL=https://github.com/urdirditfurd/videowan2g.git

# Branche distante qui reçoit les mp4
GIT_BRANCH=main

# Optionnel — durée 5, 6, 8 ou 10 secondes ; format 16:9 ou 9:16
VIDEO_DURATION_SECONDS=5
VIDEO_FORMAT=16:9

# Attentes successives quand l’API répond video_queue_full (plafond de répétitions)
VIDEO_QUEUE_MAX_RETRIES=40

# Identité des commits créés par le script (n’utilise pas le jeton)
GIT_AUTHOR_NAME=Lofi Capybara Bot
GIT_AUTHOR_EMAIL=lofi-capybara@users.noreply.github.com

# Clé API Agnes (https://platform.agnes-ai.com → Settings → API Keys)
AGNES_API_KEY=sk-remplacez-moi

# Personal Access Token GitHub autorisé à pousser sur videowan2g
# (scope classique « repo », ou contenu en écriture sur ce dépôt)
GITHUB_TOKEN=ghp_remplacez-moi

# Dépôt cible. Le script refuse tout autre dépôt que videowan2g.
GITHUB_REPO_URL=https://github.com/urdirditfurd/videowan2g.git

# Doit être exactement la branche déjà extraite localement.
# GIT_BRANCH=main

# Identité des commits créés par le script
GIT_USER_NAME=Lofi Capybara Bot
GIT_USER_EMAIL=lofi-capybara-bot@users.noreply.github.com

# Réglages de génération (optionnels)
DEFAULT_MOOD=rainy_forest
VIDEO_DURATION_SECONDS=5
VIDEO_FORMAT=16:9

# Attentes supplémentaires quand l'API répond video_queue_full (au-delà, le script s'arrête sur cette scène)
VIDEO_QUEUE_MAX_RETRIES=36

# Plafond, en secondes, de l'attente avant le premier polling (la logique d'origine reste appliquée)
VIDEO_FIRST_POLL_DELAY_SEC=80
VIDEO_MAX_POLL_ATTEMPTS=100

# SKIP_GIT=1
# VERBOSE=1

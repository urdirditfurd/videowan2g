# Clé API Agnes (https://platform.agnes-ai.com → Settings → API Keys)
AGNES_API_KEY=sk-remplacer-par-votre-cle

# Personal Access Token GitHub, droit d'écriture sur urdirditfurd/videowan2g
GITHUB_TOKEN=ghp-remplacer-par-votre-pat

# Dépôt cible, https uniquement, sans identifiant dans l'URL
GITHUB_REPO_URL=https://github.com/urdirditfurd/videowan2g.git

# Facultatif
VIDEO_DURATION_SECONDS=5
VIDEO_FORMAT=16:9
SCENES_FILE=scenes.json
OUTPUT_DIR=generated_videos
GIT_AUTHOR_NAME=Lofi Capybara Bot
GIT_AUTHOR_EMAIL=lofi-capybara-bot@users.noreply.github.com
GIT_COMMITTER_NAME=Lofi Capybara Bot
GIT_COMMITTER_EMAIL=lofi-capybara-bot@users.noreply.github.com

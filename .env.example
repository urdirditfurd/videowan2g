# Clé API Agnes (platform.agnes-ai.com → Settings → API Keys)
AGNES_API_KEY=sk-remplacez-moi

# Personal Access Token GitHub, droit d'écriture sur le contenu du dépôt
GITHUB_TOKEN=ghp_remplacez-moi

# Seule cette URL est acceptée (https, sans identifiant)
GITHUB_REPO_URL=https://github.com/urdirditfurd/videowan2g

# Optionnel : 5, 6, 8 ou 10
VIDEO_DURATION_SECONDS=5

# Optionnel : 16:9 ou 9:16
VIDEO_FORMAT=16:9

# Optionnel : rainy_forest, golden_sunset, cozy_room, japanese_garden,
# mountain_lake, autumn_leaves, night_stars, ocean_breeze
VIDEO_MOOD=rainy_forest

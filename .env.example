# Clé API Agnes (https://platform.agnes-ai.com → Settings → API Keys)
AGNES_API_KEY=sk-remplacer-par-votre-cle

# Personal Access Token GitHub (droit de pousser sur ce dépôt). Ne jamais le committer.
GITHUB_TOKEN=ghp_remplacer-par-votre-token

# Dépôt cible. https uniquement, sans identifiant dans l’URL.
GIT_REMOTE_URL=https://github.com/urdirditfurd/videowan2g

# Identité des commits créés par le script
GIT_AUTHOR_NAME=Lofi Capybara Studio
GIT_AUTHOR_EMAIL=lofi-capybara@users.noreply.github.com

# Optionnel : 5, 6, 8 ou 10
# VIDEO_SECONDS=5
# VIDEO_FORMAT=16:9
# SCENES_FILE=scenes.json
